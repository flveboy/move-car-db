generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Owner {
  id                  String              @id @default(cuid())
  username            String              @unique
  phone               String              @unique
  name                String
  email               String?
  password            String
  role                Role                @default(USER)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastLogin           DateTime?
  codes               Code[]
  vehicles            Vehicle[]
  notificationConfigs NotificationConfig? @relation("OwnerToNotificationConfig")
  records             Record[]
  replies             Reply[]
  usedResetTokens     UsedResetToken[]

  @@map("owners")
}

model Vehicle {
  id              String   @id @default(cuid())
  ownerId         String
  licensePlate    String   @unique
  brand           String?
  model           String?
  color           String?
  dingtalkWebhook String?
  dingtalkSign    Boolean  @default(false)
  dingtalkKeyword String?
  dingtalkSecret  String?
  wechatWebhook   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  codes           Code[]
  drivers         Driver[]
  owner           Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId], map: "Vehicle_ownerId_fkey")
}

model Driver {
  id              String   @id @default(cuid())
  vehicleId       String
  name            String
  phone           String
  dingtalkWebhook String?
  dingtalkSign    Boolean  @default(false)
  dingtalkKeyword String?
  dingtalkSecret  String?
  wechatWebhook   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isActive        Boolean  @default(true)
  Code            Code[]
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId], map: "Driver_vehicleId_fkey")
}

model Code {
  id        String    @id @default(cuid())
  vehicleId String
  ownerId   String
  driverId  String?
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiredAt DateTime?
  driver    Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  records   Record[]

  @@index([driverId], map: "Code_driverId_fkey")
  @@index([ownerId], map: "Code_ownerId_fkey")
  @@index([vehicleId], map: "Code_vehicleId_fkey")
}

model Record {
  id        String   @id @default(cuid())
  codeId    String
  ownerId   String
  driverId  String?
  scanTime  DateTime @default(now())
  ipAddress String?
  userAgent String?
  location  String?
  message   String?
  sessionId String?  @unique
  createdAt DateTime @default(now())
  code      Code     @relation(fields: [codeId], references: [id], onDelete: Cascade)
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  replies   Reply[]

  @@index([codeId], map: "records_codeId_fkey")
  @@index([ownerId], map: "records_ownerId_fkey")
  @@index([driverId], map: "records_driverId_fkey")
  @@index([sessionId], map: "records_sessionId_fkey")
  @@map("records")
}

model Reply {
  id         String     @id @default(cuid())
  recordId   String
  senderId   String
  message    String
  senderType SenderType @default(ADMIN)
  createdAt  DateTime   @default(now())
  record     Record     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  sender     Owner      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recordId], map: "replies_recordId_fkey")
  @@index([senderId], map: "replies_senderId_fkey")
  @@map("replies")
}

model SystemConfig {
  id          String     @id @default(cuid())
  key         String     @unique
  value       String
  type        ConfigType @default(BOOLEAN)
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("system_configs")
}

model NotificationConfig {
  id                String   @id @default(cuid())
  ownerId           String   @unique
  dingtalkWebhook   String?
  dingtalkSign      Boolean  @default(false)
  dingtalkKeyword   String?
  dingtalkSecret    String?
  wechatWebhook     String?
  wechatMessage     String?
  wechatMessageType String?  @default("text")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             Owner    @relation("OwnerToNotificationConfig", fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("notification_configs")
}

model UsedResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  usedAt    DateTime @default(now())
  owner     Owner    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("used_reset_tokens")
}

enum Role {
  USER
  ADMIN
}

enum SenderType {
  ADMIN
  USER
}

enum ConfigType {
  BOOLEAN
  STRING
  NUMBER
  JSON
}