// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Owner {
  id        String    @id @default(cuid())
  username  String    @unique // 新增用户名字段，唯一
  phone     String    @unique
  name      String // 姓名
  email     String?
  password  String // 密码哈希
  role      Role      @default(USER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  vehicles Vehicle[]
  codes    Code[]
  records  Record[]
  notificationConfigs NotificationConfig[] @relation("OwnerToNotificationConfig")

  @@map("owners")
}

enum Role {
  USER
  ADMIN
}

model Vehicle {
  id              String   @id @default(cuid())
  ownerId         String
  licensePlate    String   @unique
  brand           String?
  model           String?
  color           String?
  // 钉钉通知配置
  dingtalkWebhook String?
  dingtalkSign    Boolean  @default(false)
  dingtalkKeyword String?
  dingtalkSecret  String?
  // 企微通知配置
  wechatWebhook   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner   Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  codes   Code[]
  drivers Driver[]
}

model Driver {
  id              String   @id @default(cuid())
  vehicleId       String
  name            String
  phone           String
  isActive        Boolean  @default(true) // 新增：驾驶员启用状态
  // 钉钉通知配置
  dingtalkWebhook String?
  dingtalkSign    Boolean  @default(false)
  dingtalkKeyword String?
  dingtalkSecret  String?
  // 企微通知配置
  wechatWebhook   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  Code    Code[]
}

model Code {
  id        String    @id @default(cuid())
  vehicleId String
  ownerId   String
  driverId  String?
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiredAt DateTime?

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  owner   Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  records Record[]
}

model Record {
  id        String   @id @default(cuid())
  codeId    String
  ownerId   String // 添加所有者关联
  scanTime  DateTime @default(now())
  ipAddress String?
  userAgent String?
  location  String?
  message   String?
  createdAt DateTime @default(now())

  code  Code  @relation(fields: [codeId], references: [id], onDelete: Cascade)
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("records")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      ConfigType @default(BOOLEAN)
  name      String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

enum ConfigType {
  BOOLEAN
  STRING
  NUMBER
  JSON
}

model NotificationConfig {
  id        String   @id @default(cuid())
  ownerId   String
  @@unique([ownerId]) 
  dingtalkWebhook String?
  dingtalkSign    Boolean  @default(false)
  dingtalkKeyword String?
  dingtalkSecret  String?
  wechatWebhook   String?
  wechatMessage   String?
  wechatMessageType String? @default("text")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner Owner @relation("OwnerToNotificationConfig", fields: [ownerId], references: [id], onDelete: Cascade)
  @@map("notification_configs")
}